# =============================================================================
# SuperMap Backend Environment Variables
# 环境变量配置文件 - 按服务分组配置
# =============================================================================

# =============================================================================
# 1. AGENT服务配置 (Agent Service Configuration)
# 用于AI Agent和RAG系统的语言模型服务
# =============================================================================

# -----------------------------------------------------------------------------
# Agent服务基础配置
# -----------------------------------------------------------------------------
# 服务名称
APP_NAME=SuperMap GIS + AI Backend
# 服务版本
APP_VERSION=1.0.0
# 调试模式
DEBUG=true
# 运行环境
ENVIRONMENT=development
# 日志级别
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Agent服务LLM配置
# -----------------------------------------------------------------------------
# 阿里云通义千问API密钥
DASHSCOPE_API_KEY=sk-b494400841214e9aa17baa1d24efec62
# 通义千问API服务地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 使用的语言模型名称
DASHSCOPE_MODEL=qwen-plus
# 模型采样温度
DASHSCOPE_TEMPERATURE=0.6
# 最大生成令牌数
DASHSCOPE_MAX_TOKENS=20000

# -----------------------------------------------------------------------------
# RAG知识库数据库配置
# -----------------------------------------------------------------------------
# RAG系统PostgreSQL服务器地址
RAG_POSTGRES_HOST=localhost
# RAG系统PostgreSQL服务器端口
RAG_POSTGRES_PORT=5432
# RAG系统数据库用户名
RAG_POSTGRES_USER=postgres
# RAG系统数据库密码
RAG_POSTGRES_PASSWORD=001117
# RAG系统数据库名称
RAG_POSTGRES_DB=postgres
# RAG系统数据库模式
RAG_POSTGRES_SCHEMA=public
# RAG系统数据表名称
RAG_POSTGRES_TABLE=rag_demo_abc
# RAG系统文本列字段名
RAG_POSTGRES_TEXT_COLUMNS=a,b,c

# =============================================================================
# 2. ANALYSIS服务配置 (Analysis Service Configuration)
# 用于空间分析服务的配置
# =============================================================================

# -----------------------------------------------------------------------------
# Analysis服务基础配置
# -----------------------------------------------------------------------------
# Node.js运行环境
NODE_ENV=development
# Analysis服务端口
PORT=8087
# API版本
API_VERSION=v1
# 服务名称
SERVICE_NAME=spatial-analysis-service
# 服务版本
SERVICE_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Analysis服务限制配置
# -----------------------------------------------------------------------------
# 请求限制时间窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000
# 最大请求数
RATE_LIMIT_MAX_REQUESTS=100
# 单次分析最大要素数
MAX_FEATURES_PER_ANALYSIS=10000
# 单个要素最大顶点数
MAX_VERTICES_PER_FEATURE=1000
# 最大缓冲区距离
MAX_BUFFER_DISTANCE=100000
# 最小缓冲区距离
MIN_BUFFER_DISTANCE=0.001

# =============================================================================
# 3. USER服务配置 (User Service Configuration)
# 用于用户管理和认证服务的配置
# =============================================================================

# -----------------------------------------------------------------------------
# User服务API配置
# -----------------------------------------------------------------------------
# API版本前缀
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# 安全认证配置
# -----------------------------------------------------------------------------
# JWT密钥
SECRET_KEY=your-super-secret-key-change-this-in-production
# JWT加密算法
ALGORITHM=HS256
# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# 主数据库配置
# -----------------------------------------------------------------------------
# PostgreSQL数据库用户名
POSTGRES_USER=postgres
# PostgreSQL数据库密码
POSTGRES_PASSWORD=001117
# PostgreSQL服务器地址
POSTGRES_HOST=localhost
# PostgreSQL服务器端口
POSTGRES_PORT=5432
# 主数据库名称
POSTGRES_DB=supermap

# -----------------------------------------------------------------------------
# Redis缓存配置
# -----------------------------------------------------------------------------
# Redis服务器地址
REDIS_HOST=localhost
# Redis服务器端口
REDIS_PORT=6379
# Redis服务器密码（空表示无密码）
REDIS_PASSWORD=
# Redis数据库编号
REDIS_DB=0

# -----------------------------------------------------------------------------
# SuperMap服务器配置
# -----------------------------------------------------------------------------
# SuperMap服务器基础URL
SUPERMAP_BASE_URL=http://localhost:8090
# SuperMap服务器完整URL
SUPERMAP_SERVER_URL=http://localhost:8090
# SuperMap服务器用户名
SUPERMAP_USERNAME=admin
# SuperMap服务器密码
SUPERMAP_PASSWORD=admin

# =============================================================================
# 4. 跨服务通用配置 (Cross-Service Common Configuration)
# 多个服务共同使用的配置
# =============================================================================

# -----------------------------------------------------------------------------
# 跨域配置
# -----------------------------------------------------------------------------
# 跨域允许的源地址
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# -----------------------------------------------------------------------------
# 前端LLM配置
# -----------------------------------------------------------------------------
# 阿里云通义千问API密钥（前端专用）
VITE_DASHSCOPE_API_KEY=sk-b494400841214e9aa17baa1d24efec62
# 通义千问API服务地址（前端专用）
VITE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 使用的语言模型名称（前端专用）
VITE_DASHSCOPE_MODEL=qwen-plus
# 模型采样温度（前端专用）
VITE_DASHSCOPE_TEMPERATURE=0.5
# 最大生成令牌数（前端专用）
VITE_DASHSCOPE_MAX_TOKENS=20000