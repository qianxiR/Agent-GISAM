# =============================================================================
# SuperMap Frontend Environment Variables
# 前端环境变量配置文件 - 按功能模块分组
# =============================================================================

# =============================================================================
# 1. SuperMap数据服务配置 (SuperMap Data Service Configuration)
# =============================================================================

# -----------------------------------------------------------------------------
# SuperMap服务器基础配置
# -----------------------------------------------------------------------------
# SuperMap服务器基础URL
VITE_SUPERMAP_BASE_URL=http://localhost:8090
# SuperMap地图服务路径
VITE_SUPERMAP_MAP_SERVICE=iserver/services/map-guanlifenxipingtai-2/rest/map
# SuperMap数据服务路径
VITE_SUPERMAP_DATA_SERVICE=iserver/services/data-guanlifenxipingtai-2/rest/data


# -----------------------------------------------------------------------------
# SuperMap工作空间和地图配置
# -----------------------------------------------------------------------------
# SuperMap工作空间名称
VITE_SUPERMAP_WORKSPACE=wuhan
# SuperMap地图名称
VITE_SUPERMAP_MAP_NAME=wuhan_map
# SuperMap数据集名称
VITE_SUPERMAP_DATASET_NAME=

# -----------------------------------------------------------------------------
# SuperMap地图显示配置
# -----------------------------------------------------------------------------
# 地图显示范围 (最小经度,最小纬度,最大经度,最大纬度)
VITE_SUPERMAP_MAP_EXTENT=113.7,29.97,115.08,31.36
# 地图中心点坐标 (经度,纬度)
VITE_SUPERMAP_MAP_CENTER=114.37,30.69
# 地图初始缩放级别
VITE_SUPERMAP_MAP_ZOOM=8

# -----------------------------------------------------------------------------
# SuperMap底图服务配置
# -----------------------------------------------------------------------------
# 浅色底图服务URL
VITE_SUPERMAP_BASEMAP_LIGHT=http://localhost:8090/iserver/services/map-China/rest/maps/China_Light?prjCoordSys=%7B%22epsgCode%22:4326%7D
# 深色底图服务URL
VITE_SUPERMAP_BASEMAP_DARK=http://localhost:8090/iserver/services/map-China/rest/maps/China_Dark

# =============================================================================
# 2. 辅助工具配置 (Auxiliary Tools Configuration)
# =============================================================================

# -----------------------------------------------------------------------------
# API请求配置
# -----------------------------------------------------------------------------
# API请求超时时间（毫秒）
VITE_API_TIMEOUT=10000
# API请求重试次数
VITE_API_RETRY_COUNT=3
# 开发模式开关
VITE_DEV_MODE=true

# -----------------------------------------------------------------------------
# AI语言模型配置
# -----------------------------------------------------------------------------
# 阿里云通义千问API密钥
VITE_DASHSCOPE_API_KEY=sk-4d0d9ac8cfff4e66a7d6601def288989
# 通义千问API服务地址
VITE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 使用的语言模型名称
VITE_DASHSCOPE_MODEL=qwen-plus
# 模型采样温度
VITE_DASHSCOPE_TEMPERATURE=0.5
# 最大生成令牌数
VITE_DASHSCOPE_MAX_TOKENS=10000

# =============================================================================
# 3. 需链接的端口配置 (Required Service Ports Configuration)
# =============================================================================

# -----------------------------------------------------------------------------
# 用户服务端口配置 (Python FastAPI)
# -----------------------------------------------------------------------------
# 用户服务基础URL
VITE_USER_SERVICE_BASE_URL=http://localhost:8088
# 用户服务API前缀
VITE_USER_SERVICE_API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# 空间分析服务端口配置 (Node.js)
# -----------------------------------------------------------------------------
# 空间分析服务基础URL
VITE_ANALYSIS_SERVICE_BASE_URL=http://localhost:8087
# 空间分析服务API前缀
VITE_ANALYSIS_SERVICE_API_PREFIX=/api/v1/spatial-analysis

# -----------------------------------------------------------------------------
# AI Agent服务端口配置 (Python FastAPI)
# -----------------------------------------------------------------------------
# AI Agent服务基础URL
AGENT_API_BASE_URL=http://localhost:8089
